# Configure environment variables in your hosting service; never commit .env.
# Optional: override permanent per-user storage for a hosted or isolated service.
# TGTOP_DATA=/srv/tgtop/data
TGTOP_ORIGIN=http://127.0.0.1:8765
TGTOP_HOST=127.0.0.1
TGTOP_PORT=8765
# Live mode requires HTTPS, an always-on host and the variables below.
TGTOP_MODE=development
OPENAI_API_KEY=
OPENAI_MODEL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_VERIFY_SERVICE_SID=
# Exact public URL, including path; signature validation uses this verbatim.
TWILIO_WEBHOOK_URL=https://your-host.example/api/sms/incoming
# Restrict device agent to these directories, separated by os.pathsep.
TGTOP_APPROVED_ROOTS=

# Remote sign-up is disabled by default. Enable only for an intentional multi-user deployment.
TGTOP_ALLOW_SIGNUP=0

# Public hostname for deploy/compose.yaml, without protocol or a path.
TGTOP_DOMAIN=
