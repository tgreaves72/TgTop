{
  "name": "tgtop",
  "version": "0.2.0",
  "description": "Connected personal task workspace",
  "main": "desktop/main.cjs",
  "author": "TgTop",
  "license": "MIT",
  "scripts": {
    "desktop": "electron .",
    "package": "electron-builder --win nsis",
    "test": "python -m pytest -q"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.tgtop.desktop",
    "productName": "TgTop",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/tgtop-server",
        "to": "server"
      },
      {
        "from": "runtime/photon-package",
        "to": "photon"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "@opentelemetry/core": "^2.8.0"
  },
  "dependencies": {
    "@spectrum-ts/core": "12.10.1",
    "@spectrum-ts/imessage": "12.10.1"
  }
}
